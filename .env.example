# AMBIT SecretGuard – Environment Variables
# Copy this file to .env and fill in your values

# ── GitHub Tokens ──────────────────────────────────────────────────────────
# Store each GitHub PAT using the pattern GITHUB_TOKEN_<USERNAME_UPPERCASE>
# Replace USERNAME with the actual GitHub username (uppercase, hyphens → underscores)
#
# Example:
#   GITHUB_TOKEN_JOHNDOE=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   GITHUB_TOKEN_JANE_DOE=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   GITHUB_TOKEN_THIRD_USER=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

GITHUB_TOKEN_USER1=
GITHUB_TOKEN_USER2=
GITHUB_TOKEN_USER3=

# ── Webhook ────────────────────────────────────────────────────────────────
# A secret shared between GitHub and SecretGuard for signature verification
GITHUB_WEBHOOK_SECRET=ambit-secretguard-webhook-secret

# The public URL where GitHub can reach your webhook endpoint
# Use ngrok for local development: ngrok http 5000
# Example: https://abc123.ngrok.io
WEBHOOK_PUBLIC_URL=

# ── Flask ─────────────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=1
